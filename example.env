# Copy to .env and fill in: cp example.env .env
# Optional: every endpoint except /assist works without it.
# LLM_API_KEY=<your-openai-api-key>

LLM_MODEL=gpt-6-luna
# LLM_BASE_URL=        # optional: proxy or Azure OpenAI endpoint (default: api.openai.com)
LLM_TIMEOUT_SECONDS=20

DB_PATH=data/incidents.db
PORT=8000
LOG_LEVEL=INFO
