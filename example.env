# Copy to .env and fill in: cp example.env .env
# Optional: every endpoint except /assist works without it.
# LLM_API_KEY=<your-provider-key>

LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
# LLM_BASE_URL=        # optional: override the provider's URL (any OpenAI-compatible endpoint)
LLM_TIMEOUT_SECONDS=20

DB_PATH=data/incidents.db
PORT=8000
LOG_LEVEL=INFO
